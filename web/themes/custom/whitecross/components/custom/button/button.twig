{% set button_variant = variant|default('primary') %}
{% set button_size = size|default('medium') %}
{% set button_text_color = text_color|default('default') %}
{% set button_bg_color = bg_color|default('default') %}
{% set has_icon = icon is not empty %}

{% set button_variants =
  html_cva(
    base: [
      'legacy-btn group flex items-center justify-center transition duration-300 ease-in-out',
      'rounded-lg leading-tight font-medium',
      'cursor-pointer no-underline outline-none hover:no-underline',
      'focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]'
    ],
    variants: {
      size: {
        small: 'gap-1 px-4 py-2 text-sm xl:py-2.5 xl:text-md',
        medium: 'gap-2 px-5 py-2 text-md xl:py-3 xl:text-lg',
        large: 'gap-3 px-6 py-3 text-lg xl:py-3.5 xl:text-xl'
      },
      variant: {
        primary: ['bg-primary text-primary-foreground duration-300 ease-in-out hover:bg-primary/85'],
        secondary: ['bg-accent text-accent-foreground duration-300 ease-in-out hover:bg-accent/80'],
        'primary-inverted': ['bg-primary-foreground text-primary duration-300 ease-in-out hover:bg-primary-foreground/85'],
        'secondary-inverted': ['border border-accent bg-accent-foreground text-accent duration-300 ease-in-out hover:bg-accent-foreground/80']
      },
      width: {
        full: 'w-full sm:w-fit',
        fit: 'w-fit'
      },
      iconPosition: {
        first: 'flex-row',
        last: 'flex-row-reverse'
      },
      textColor: {
        default: '',
        black: 'text-black! hover:text-black!',
        white: 'text-white! hover:text-white!'
      },
      bgColor: {
        default: '',
        'radley-purple': 'bg-radley-purple! text-white! hover:bg-radley-purple-hover!',
        'radley-blue': 'bg-radley-blue! text-black! hover:bg-radley-blue-hover!',
        'radley-red': 'bg-radley-red! text-white! hover:bg-radley-red-hover!',
        pink: 'bg-pink! text-black! hover:bg-pink/85!'
      }
    }
  )
%}

{% set icon_size_map = {
  small: 'extra-extra-small',
  medium: 'extra-small',
  large: 'small'
} %}

{% set button_width = mobile_width|default(false) ? 'full' : 'fit' %}
{% set icon_position = icon_first|default(false) ? 'first' : 'last' %}
{% set icon_classes = 'transition duration-300 ease-in-out group-hover:translate-x-1' %}

{# Normalize btn_classes - handle both array and string formats #}
{% set additional_classes = btn_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{# If href is provided, present a link; otherwise render a button #}
{% set href_url = href is iterable ? href.url|default(href.uri)|default(href.path)|default(href.href)|default('') : href %}

{% if href_url is not empty %}
  <a
    href="{{ href_url }}"
    class="{{
    button_variants.apply(
      {
        size: button_size,
        variant: button_variant,
        textColor: button_text_color,
        bgColor: button_bg_color,
        width: button_width,
        iconPosition: has_icon ? icon_position : 'last'
      },
      additional_classes
    )
    }}"
  >
    {% if has_icon %}
      <span class="{{ icon_classes }}">
        {{
          include(
            '@whitecross/components/icon/icon.twig',
            {
              weight: 'bold',
              icon: icon,
              icon_size: icon_size_map[button_size]
            },
            with_context: false
          )
        }}
      </span>
    {% endif %}
    {{ label }}
  </a>
{% else %}
  <button
    class="{{
    button_variants.apply(
      {
        size: button_size,
        variant: button_variant,
        textColor: button_text_color,
        bgColor: button_bg_color,
        width: button_width,
        iconPosition: has_icon ? icon_position : 'last'
      },
      additional_classes
    )
    }}"
  >
    {% if has_icon %}
      <span class="{{ icon_classes }}">
        {{
          include(
            '@whitecross/components/icon/icon.twig',
            {
              weight: 'bold',
              icon: icon,
              icon_size: icon_size_map[button_size]
            },
            with_context: false
          )
        }}
      </span>
    {% endif %}
    {{ label }}
  </button>
{% endif %}
