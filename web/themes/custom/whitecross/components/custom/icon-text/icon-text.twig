{#
/**
 * @file
 * icon-text.twig
 *
 * Renders an inline icon alongside a text string or link.
 */
#}

{% set color_classes = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  accent: 'text-accent',
  neutral: 'text-neutral',
  inherit: 'text-current'
} %}

{% set resolved_color_class = color_classes[icon_color|default('primary')]|default('text-primary') %}

{% set text_size_classes = {
  'text-sm': 'text-sm',
  normal: 'text-base',
  'text-lg': 'text-lg',
  'text-xl': 'text-xl'
} %}

{% set resolved_text_size = text_size_classes[text_size|default('normal')]|default('text-base') %}

<div class="icon-text flex items-center gap-3 py-1 text-base-content">
  <span class="{{ resolved_color_class }} shrink-0 flex items-center justify-center" aria-hidden="true">
    {{
      include(
        '@whitecross/components/icon/icon.twig',
        {
          icon: icon|default('map-pin'),
          icon_size: icon_size|default('small')
        }
      )
    }}
  </span>

  <div class="flex-1 {{ resolved_text_size }} leading-normal">
    {% if url is not empty %}
      <a href="{{ url }}" class="hover:text-primary transition-colors inline-block">
        {{ text }}
      </a>
    {% else %}
      <span>{{ text }}</span>
    {% endif %}
  </div>
</div>
